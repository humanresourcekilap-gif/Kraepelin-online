# ============================================
# SUPABASE CONFIGURATION
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ============================================
# SECURITY & AUTHENTICATION SECRETS
# Gunakan string acak panjang (misal 64 karakter) untuk penandatanganan HMAC cookies
# ============================================
ASSESSMENT_COOKIE_SECRET=generate-random-secret-key-for-assessment-cookies
ADMIN_COOKIE_SECRET=generate-random-secret-key-for-admin-cookies

# ============================================
# ADMIN CREDENTIALS (DASHBOARD LOGIN)
# Kredensial untuk login ke /admin/login
# ============================================
ADMIN_EMAIL=admin@kraepelin.com
ADMIN_PASSWORD=your-strong-admin-password

